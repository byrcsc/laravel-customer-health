parameters:
    level: max
    paths:
        - src
        - config
        # The stub models are what a host app's trackable models look like, so
        # keeping them in scope proves the package's abstractions line up
        # against a real Eloquent model rather than only against itself.
        - tests/Stubs
    tmpDir: build/phpstan

    # This is a package, so Larastan cannot boot an application to discover
    # where config files live. Point it at ours, otherwise anything read from
    # config/customer-health.php is opaque to it.
    configDirectories:
        - config
